# Local PostgreSQL development environment (compose.yaml).
APP_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
# Required only when running Alembic or the application outside Compose.
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:<port>/<database>

BINDER_LOCALE=
BINDER_MAX_UPLOAD_MB=
BINDER_GOOGLE_DRIVE_IMPORT_ENABLED=
BINDER_GOOGLE_CLIENT_ID=
BINDER_GOOGLE_API_KEY=

# Semantic search (embeddings from a local Ollama model). Leave BINDER_SEMANTIC_SEARCH empty
# to keep it on; set it to 0 to turn it off. Keyword search always works.
BINDER_SEMANTIC_SEARCH=
# Ollama model name. Changing it re-embeds documents after the next run (see README).
BINDER_EMBEDDING_MODEL=bge-m3
# Must match the output size of BINDER_EMBEDDING_MODEL (bge-m3 produces 1024).
BINDER_EMBEDDING_DIMENSIONS=1024
# Cosine similarity floor for semantic matches (0 to 1).
BINDER_SEMANTIC_MIN_SIMILARITY=0.5
# Ollama address when running the app outside Compose (Compose sets http://ollama:11434).
OLLAMA_BASE_URL=http://localhost:11434
